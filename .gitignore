node_modules/
dist/
*.log
.npm-cache/
.DS_Store

# lib/*.js are GENERATED by `npm run build` (tsc from lib/*.ts, esbuild from client/*.ts).
# They MUST be committed so that git-based installs (`github:Psynosaur/dsh-token-gobbler`
# in a DSH profile's dependencies) carry the compiled modules the DSH host loads.
# npm does not compile lib/*.ts for a git dependency, so lib/*.js are the shipped artifact.
# Regenerate them with `npm run build` whenever you edit the lib/*.ts sources.
!lib/*.js
package-lock.json
